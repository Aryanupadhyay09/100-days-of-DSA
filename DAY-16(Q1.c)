#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    int freq[n];  // to store frequency counts
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        freq[i] = -1;  // initialize with -1 (unprocessed)
    }

    for (int i = 0; i < n; i++) {
        if (freq[i] == -1) {  // not yet counted
            int count = 1;
            for (int j = i + 1; j < n; j++) {
                if (arr[i] == arr[j]) {
                    count++;
                    freq[j] = 0;  // mark as counted
                }
            }
            freq[i] = count;
        }
    }

    for (int i = 0; i < n; i++) {
        if (freq[i] > 0) {
            printf("%d:%d ", arr[i], freq[i]);
        }
    }

    return 0;
}
