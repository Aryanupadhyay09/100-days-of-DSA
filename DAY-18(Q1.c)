#include <stdio.h>

int main() {
    int n, k;
    
    // Input size of array
    scanf("%d", &n);
    
    int arr[n];
    
    // Input array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Input number of rotations
    scanf("%d", &k);
    
    // Normalize k (in case k > n)
    k = k % n;
    
    // Print rotated array
    for (int i = 0; i < n; i++) {
        int index = (i + n - k) % n;  // Calculate new index after rotation
        printf("%d ", arr[index]);
    }
    
    return 0;
}
