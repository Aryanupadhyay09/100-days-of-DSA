#include <stdio.h>

// Recursive function to calculate a^b
int power(int a, int b) {
    if (b == 0) {
        return 1;  // Base case: anything raised to 0 is 1
    } else {
        return a * power(a, b - 1);  // Recursive step
    }
}

int main() {
    int a, b;
    scanf("%d %d", &a, &b);

    int result = power(a, b);
    printf("%d\n", result);

    return 0;
}
